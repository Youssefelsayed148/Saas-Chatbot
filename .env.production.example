# Production settings for compose.prod.yaml. Copy to .env.production (never commit it)
# and replace every value. `chmod 600 .env.production`.

# Public host name served by Caddy (DNS A/AAAA record must already point at the VPS).
DOMAIN=chat.example.com
ACME_EMAIL=ops@example.com

# Database (the db container is private to the compose network).
POSTGRES_DB=saas
POSTGRES_USER=saas
POSTGRES_PASSWORD=replace-with-a-long-random-password

# First platform-admin account. Created/updated on every deploy while the password is set.
PLATFORM_STAFF_EMAIL=admin@example.com
PLATFORM_STAFF_PASSWORD=replace-with-a-strong-password

# Encrypts channel signing secrets; required by production startup.
# Comma-separated Fernet keys, newest first. Reuse deployed keys on rebuild;
# losing old keys makes stored channel secrets unreadable. See DEPLOY.md.
# Leave this template empty: provision real keys securely, never in Git/logs.
CHANNEL_SECRET_ENCRYPTION_KEYS=

# Premium chat model (OpenAI) and embeddings. Both use the same OpenAI key.
CHAT_OPENAI_API_KEY=
CHAT_OPENAI_MODEL=gpt-5.4-nano
# Optional ordered fallbacks, JSON array, at most 3: ["model-a","model-b"]
CHAT_OPENAI_FALLBACK_MODELS=[]
EMBEDDING_PROVIDER=openai
# Empty = text-embedding-3-large (1024 dimensions).
EMBEDDING_MODEL=

# Free tier (OpenRouter). Leave the chain as [] to disable.
CHAT_OPENROUTER_API_KEY=
CHAT_FREE_MODEL_CHAIN=[]

# Retrieval gate (UNTUNED defaults; change only after an owner calibration run).
RETRIEVAL_MIN_FTS_MATCH=0.01
RETRIEVAL_MIN_MATCHED_TERMS=2

# Backups kept on the VPS under ./backups (copy them off-box as well).
BACKUP_KEEP_DAYS=14
