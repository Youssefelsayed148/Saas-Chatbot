{
  "name": "saas-chats-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "format": "prettier --write apps/web package.json .github/workflows/ci.yml infra/compose.yaml",
    "format:check": "prettier --check apps/web package.json .github/workflows/ci.yml infra/compose.yaml",
    "test": "npm run test --workspace apps/web"
  }
}
