# Local development only. Replace before starting Compose. Never commit .env.
POSTGRES_DB=chatbot_dev
POSTGRES_USER=chatbot_dev
POSTGRES_PASSWORD=replace-with-local-development-password
DATABASE_URL=postgresql://chatbot_dev:replace-with-local-development-password@127.0.0.1:55432/chatbot_dev
CHAT_OPENROUTER_API_KEY=
CHAT_FREE_MODEL_CHAIN=
CHAT_OPENAI_API_KEY=
# Premium tier model. gpt-4.1-nano is deprecated by OpenAI (404 model_not_found); gpt-5.4-nano is the verified replacement.
CHAT_OPENAI_MODEL=gpt-5.4-nano
# Optional ordered Premium fallbacks tried after CHAT_OPENAI_MODEL (JSON array, at most 3 unique ids).
# CHAT_OPENAI_FALLBACK_MODELS=["fallback-model-id"]
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set one or more comma-separated Fernet keys, newest first. Never commit a real key.
CHANNEL_SECRET_ENCRYPTION_KEYS=
EMBEDDING_PROVIDER=openai
# Empty model selects text-embedding-3-large for OpenAI (bge-m3 for optional Ollama).
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
# UNTUNED, pending owner calibration
RETRIEVAL_VECTOR_FLOORS={"openai:text-embedding-3-large":0.50,"ollama:bge-m3":0.50}
RETRIEVAL_MIN_FTS_MATCH=0.01
RETRIEVAL_MIN_MATCHED_TERMS=2
# Optional per-model override: {"openai:text-embedding-3-large":{"min_fts_match":0.05,"min_matched_terms":2}}
RETRIEVAL_KEYWORD_GATES={}
